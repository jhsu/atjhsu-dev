---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About — Joe Hsu';
const description = 'Joe Hsu is a software engineer in New York writing about building software with AI agents.';
const permalink = `${Astro.site.href}about`;
---

<BaseLayout title={title} description={description} permalink={permalink} current="about">
  <header class="about-header">
    <img class="portrait" src="/assets/profile.png" alt="Joe Hsu" width="400" height="400" fetchpriority="high" />
    <div>
      <p class="eyebrow">About</p>
      <h1>I’m Joe, a software engineer in New York.</h1>
      <p class="about-lead">
        I build software and pay attention to how the work gets done — the context, the tools, the
        constraints, and the feedback loops around it.
      </p>
    </div>
  </header>

  <section class="about-body">
    <h2>What I write about</h2>
    <p>
      I’m a software engineer at <a href="https://getwhys.io" target="_blank" rel="noopener">GetWhys</a>,
      where I work on products that help teams understand and serve their customers.
    </p>
    <p>
      I’ve become increasingly interested in the work that happens before code gets written: collecting
      the right context, shaping a problem, choosing tools, defining boundaries, and setting up fast
      feedback.
    </p>
    <p>
      That preparation matters even more when an AI agent can produce a lot of code quickly. Speed is
      useful, but only when the setup is good enough to aim it.
    </p>
    <p>
      This is where I share what I’m trying, building, and learning. The notes are practical,
      exploratory, and grounded in real projects.
    </p>
  </section>

  <section class="about-block">
    <h2>Now</h2>
    <ul role="list">
      <li>Working on agent tools and small products that make daily work easier.</li>
      <li>Exploring deliberately simple coding-agent setups — one agent at a time.</li>
      <li>Writing here about what holds up once the demos are over.</li>
    </ul>
  </section>

  <section class="about-block">
    <h2>Elsewhere</h2>
    <ul class="link-list" role="list">
      <li><a href="https://github.com/jhsu" target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a></li>
      <li><a href="https://x.com/jhsu" target="_blank" rel="noopener">X <span aria-hidden="true">↗</span></a></li>
      <li><a href="/rss.xml">RSS feed <span aria-hidden="true">↗</span></a></li>
    </ul>
  </section>

  <section class="about-block colophon">
    <h2>Colophon</h2>
    <p>
      Set in Merriweather and Fira Sans. Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
      and hosted on Cloudflare.
    </p>
  </section>
</BaseLayout>

<style>
  .about-header {
    align-items: start;
    border-bottom: 1px solid var(--surface-border);
    display: grid;
    gap: 1.75rem;
    grid-template-columns: 8rem minmax(0, 1fr);
    padding-bottom: 2.25rem;
  }

  .portrait {
    background: var(--surface-muted);
    border-radius: 50%;
    filter: saturate(0.9);
    height: 8rem;
    object-fit: cover;
    width: 8rem;
  }

  .about-header h1 {
    font-size: clamp(1.9rem, 4.4vw, 2.6rem);
    letter-spacing: -0.025em;
    line-height: 1.18;
    margin-top: 0.5rem;
    max-width: 22ch;
  }

  .about-lead {
    color: var(--text-secondary);
    font-size: clamp(1.05rem, 2.2vw, 1.2rem);
    line-height: 1.65;
    margin-top: 1rem;
    max-width: 44ch;
  }

  .about-body {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    max-width: var(--reading-width);
  }

  .about-body h2,
  .about-block h2 {
    font-size: 1.35rem;
  }

  .about-body p {
    color: var(--text-secondary);
    margin-top: 1.1rem;
  }

  .about-body a,
  .colophon a {
    box-shadow: inset 0 -0.08em 0 var(--accent-color);
    text-decoration: none;
  }

  .about-block {
    border-top: 1px solid var(--surface-border);
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    max-width: var(--reading-width);
    padding-top: 1.5rem;
  }

  .about-block ul {
    color: var(--text-secondary);
    margin-top: 1rem;
    padding-left: 1.2rem;
  }

  .about-block li + li {
    margin-top: 0.5rem;
  }

  .link-list {
    display: grid;
    font-family: var(--font-family-sans);
    font-size: 0.92rem;
    gap: 0.5rem;
    list-style: none;
  }

  .about-block ul.link-list {
    padding-left: 0;
  }

  .link-list a {
    text-decoration: none;
  }

  .link-list a:hover {
    color: var(--accent-color);
  }

  .colophon p {
    color: var(--text-secondary);
    font-family: var(--font-family-sans);
    font-size: 0.88rem;
    margin-top: 1rem;
  }

  @media (max-width: 560px) {
    .about-header {
      gap: 1.25rem;
      grid-template-columns: 1fr;
    }

    .portrait {
      height: 6rem;
      width: 6rem;
    }
  }
</style>
