---
import { getCollection, render } from 'astro:content'
import readingTime from 'reading-time'
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bio from '../../components/Bio.astro';

export async function getStaticPaths() {
	const posts = await getCollection('posts')
  return posts.map(p => ({
    params: { slug: p.data.slug },
    props: { post: p },
  }));
}

const { post } = Astro.props
const { title, slug, description, publishDate } = post.data;
const readingTimeEstimate = readingTime(post.body ?? '').text
const permalink = `${Astro.site.href}blog/${slug}`;
const isoDate = new Date(publishDate).toISOString();
const { Content } = await render(post)
---

<BaseLayout title={title} description={description} permalink={permalink} current="blog">
  <article class="post">
    <a class="back-link" href="/blog"><span aria-hidden="true">←</span> All writing</a>
    <header class="post-header">
      <h1>{title}</h1>
      <p class="post-standfirst">{description}</p>
      <p class="post-meta">
        <span>By Joe Hsu</span>
        <span class="dot" aria-hidden="true">·</span>
        <time datetime={isoDate}>{publishDate}</time>
        <span class="dot" aria-hidden="true">·</span>
        <span>{readingTimeEstimate}</span>
      </p>
    </header>

    <div class="content prose">
      <Content />
    </div>
    <div class="image-lightbox" hidden aria-hidden="true">
      <img alt="" />
    </div>
    <Bio />
  </article>
</BaseLayout>

<script>
  const contentImages = Array.from(document.querySelectorAll('.content img'));
  const lightbox = document.querySelector('.image-lightbox');
  const lightboxImage = lightbox?.querySelector('img');

  if (lightbox && lightboxImage && contentImages.length > 0) {
    const closeLightbox = () => {
      lightbox.hidden = true;
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('lightbox-open');
      lightboxImage.removeAttribute('src');
      lightboxImage.alt = '';
    };

    closeLightbox();

    const openLightbox = (image) => {
      lightboxImage.src = image.currentSrc || image.src;
      lightboxImage.alt = image.alt || '';
      lightbox.hidden = false;
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.classList.add('lightbox-open');
    };

    contentImages.forEach((image) => {
      image.classList.add('zoomable-image');
      image.addEventListener('click', () => {
        if (!lightbox.hidden && lightboxImage.src === (image.currentSrc || image.src)) {
          closeLightbox();
          return;
        }

        openLightbox(image);
      });
    });

    lightbox.addEventListener('click', closeLightbox);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !lightbox.hidden) {
        closeLightbox();
      }
    });
  }
</script>

<style>
  .post {
    margin: 0 auto;
    max-width: var(--reading-width);
  }

  .back-link {
    color: var(--text-tertiary);
    font-family: var(--font-family-sans);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--accent-color);
  }

  .post-header {
    border-bottom: 1px solid var(--surface-border);
    margin-top: 1.25rem;
    padding-bottom: 2rem;
  }

  .post-header h1 {
    font-size: clamp(2rem, 4.6vw, 2.9rem);
    letter-spacing: -0.025em;
    line-height: 1.14;
    text-wrap: pretty;
  }

  .post-standfirst {
    color: var(--text-secondary);
    font-size: clamp(1.1rem, 2.2vw, 1.25rem);
    line-height: 1.6;
    margin-top: 1rem;
    max-width: 42ch;
  }

  .post-meta {
    color: var(--text-tertiary);
    font-family: var(--font-family-sans);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    line-height: 1.5;
    margin-top: 1.5rem;
  }

  .post-meta .dot {
    color: var(--accent-color);
    padding: 0 0.4rem;
  }

  .content {
    margin-top: 2.5rem;
  }

  :global(body.lightbox-open) {
    overflow: hidden;
  }

  :global(.content img.zoomable-image) {
    cursor: zoom-in;
  }

  .image-lightbox[hidden] {
    display: none;
  }

  .image-lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: color-mix(in srgb, black 82%, transparent);
    cursor: zoom-out;
  }

  .image-lightbox img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.35);
  }
</style>
