---
import { getCollection } from 'astro:content'
import readingTime from 'reading-time'
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Joe Hsu';
const description = 'I’m Joe Hsu, a software engineer in New York. I write about building software with AI agents and the systems around the work.';
const permalink = Astro.site.href;

const posts = (await getCollection('posts'))
  .sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf());
const recentPosts = posts.slice(0, 5);

const toISO = (date) => new Date(date).toISOString();
const readTime = (post) => readingTime(post.body ?? '').text;
---

<BaseLayout title={title} description={description} permalink={permalink}>
  <section class="intro" aria-labelledby="intro-title">
    <img class="portrait" src="/assets/profile.png" alt="Joe Hsu" width="200" height="200" fetchpriority="high" />
    <div class="intro-copy">
      <h1 id="intro-title">Hi, I’m Joe.</h1>
      <p class="intro-lead">
        I’m a software engineer in New York. I write about building with AI agents — what works, what
        doesn’t, and the systems that make the work calmer and easier to verify.
      </p>
      <p class="intro-note">Field notes from projects, hackathons, and tools I’m trying.</p>
      <ul class="intro-links" role="list">
        <li><a href="https://github.com/jhsu" target="_blank" rel="noopener">GitHub</a></li>
        <li><a href="https://x.com/jhsu" target="_blank" rel="noopener">X</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </div>
  </section>

  <section class="writing" aria-labelledby="writing-title">
    <div class="section-head">
      <h2 id="writing-title">Latest writing</h2>
      <a class="all-link" href="/blog">All posts <span aria-hidden="true">→</span></a>
    </div>

    <ol class="post-list" role="list">
      {recentPosts.map((post) => (
        <li>
          <article>
            <p class="post-meta">
              <time datetime={toISO(post.data.publishDate)}>{post.data.publishDate}</time>
              <span class="dot" aria-hidden="true">·</span>
              <span>{readTime(post)}</span>
            </p>
            <h3><a href={`/blog/${post.data.slug}`}>{post.data.title}</a></h3>
            <p class="post-description">{post.data.description}</p>
          </article>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .intro {
    align-items: start;
    display: grid;
    gap: 1.75rem;
    grid-template-columns: 5rem minmax(0, 1fr);
  }

  .portrait {
    background: var(--surface-muted);
    border-radius: 50%;
    filter: saturate(0.9);
    height: 5rem;
    object-fit: cover;
    width: 5rem;
  }

  .intro h1 {
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .intro-lead {
    color: var(--text-main);
    font-size: clamp(1.1rem, 2.2vw, 1.25rem);
    line-height: 1.65;
    margin-top: 1rem;
    max-width: 40ch;
  }

  .intro-note {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.65;
    margin-top: 0.85rem;
    max-width: 44ch;
  }

  .intro-links {
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-family-sans);
    font-size: 0.82rem;
    gap: 0.4rem 1.1rem;
    list-style: none;
    margin-top: 1.4rem;
    padding: 0;
  }

  .intro-links a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .intro-links a:hover {
    color: var(--accent-color);
  }

  .writing {
    margin-top: clamp(3.25rem, 7vw, 4.5rem);
  }

  .section-head {
    align-items: baseline;
    border-bottom: 1px solid var(--surface-border);
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    padding-bottom: 0.9rem;
  }

  .section-head h2 {
    font-size: 1.35rem;
  }

  .all-link {
    color: var(--text-secondary);
    font-family: var(--font-family-sans);
    font-size: 0.82rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .all-link:hover {
    color: var(--accent-color);
  }

  .post-list {
    list-style: none;
    padding: 0;
  }

  .post-list li {
    border-bottom: 1px solid var(--surface-border);
  }

  .post-list article {
    padding: 1.75rem 0;
  }

  .post-meta {
    color: var(--text-tertiary);
    font-family: var(--font-family-sans);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    line-height: 1.5;
  }

  .post-meta .dot {
    padding: 0 0.4rem;
    color: var(--accent-color);
  }

  .post-list h3 {
    font-size: clamp(1.35rem, 2.8vw, 1.65rem);
    line-height: 1.25;
    margin-top: 0.5rem;
  }

  .post-list h3 a {
    text-decoration: none;
  }

  .post-list h3 a:hover {
    color: var(--accent-color);
  }

  .post-description {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.65;
    margin-top: 0.55rem;
    max-width: 58ch;
  }

  @media (max-width: 560px) {
    .intro {
      gap: 1.25rem;
      grid-template-columns: 3.5rem minmax(0, 1fr);
    }

    .portrait {
      height: 3.5rem;
      width: 3.5rem;
    }
  }
</style>
