---
import Logo from './Logo.astro'
import Nav from './Nav.astro'

const { current = '' } = Astro.props;
---

<style>
  header {
    border-bottom: 1px solid var(--surface-border);
    width: 100%;
  }

  .masthead {
    align-items: center;
    display: flex;
    gap: 1.5rem;
    justify-content: space-between;
    margin: 0 auto;
    max-width: var(--page-width);
    padding: 1.5rem;
    width: 100%;
  }
</style>

<header>
  <div class="masthead">
    <Logo />
    <Nav current={current} />
  </div>
</header>
