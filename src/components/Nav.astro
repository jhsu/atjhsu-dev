---
import ThemeToggleButton from './ThemeToggleButton.svelte';
const { current = '' } = Astro.props;

const links = [
  { href: '/blog', label: 'Writing', value: 'blog' },
  { href: '/about', label: 'About', value: 'about' },
  { href: '/rss.xml', label: 'RSS', value: 'rss' },
];
---

<nav aria-label="Primary">
  <div class="desktop-links">
    {links.map((link) => (
      <a class={current === link.value ? 'selected' : ''} aria-current={current === link.value ? 'page' : undefined} href={link.href}>
        {link.label}
      </a>
    ))}
  </div>

  <details class="mobile-menu">
    <summary>Menu</summary>
    <div class="mobile-panel">
      {links.map((link) => (
        <a class={current === link.value ? 'selected' : ''} aria-current={current === link.value ? 'page' : undefined} href={link.href}>
          {link.label}
        </a>
      ))}
    </div>
  </details>

  <div class="theme-toggle-container">
    <ThemeToggleButton client:load />
  </div>
</nav>

<style>
  nav,
  .desktop-links {
    align-items: center;
    display: flex;
  }

  nav {
    gap: 1.25rem;
  }

  .desktop-links {
    gap: 1.1rem;
  }

  a,
  summary {
    color: var(--text-secondary);
    font-family: var(--font-family-sans);
    font-size: 0.88rem;
    line-height: 1;
    text-decoration: none;
  }

  a {
    padding: 0.4rem 0;
    transition: color 140ms ease;
  }

  a:hover {
    color: var(--accent-color);
  }

  a.selected {
    border-bottom: 1px solid var(--accent-color);
    color: var(--text-main);
    padding-bottom: 0.3rem;
  }

  .mobile-menu {
    display: none;
    position: relative;
  }

  summary {
    cursor: pointer;
    list-style: none;
    padding: 0.4rem 0;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    color: var(--accent-color);
    content: ' +';
  }

  details[open] summary::after {
    content: ' −';
  }

  .mobile-panel {
    background: var(--surface-elevated);
    border: 1px solid var(--surface-border);
    box-shadow: 0 0.75rem 2rem var(--surface-shadow);
    display: grid;
    gap: 0.15rem;
    min-width: 9rem;
    padding: 0.6rem;
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    z-index: 20;
  }

  .mobile-panel a {
    padding: 0.45rem 0.5rem;
  }

  .mobile-panel a.selected {
    background: var(--surface-muted);
    border-bottom: 0;
    padding-bottom: 0.45rem;
  }

  .theme-toggle-container {
    display: flex;
  }

  @media (max-width: 640px) {
    nav {
      gap: 0.75rem;
    }

    .desktop-links {
      display: none;
    }

    .mobile-menu {
      display: block;
    }
  }
</style>
